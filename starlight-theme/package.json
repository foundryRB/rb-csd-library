{
  "name": "@foundryrb/starlight-theme",
  "version": "1.3.2",
  "description": "RB Software Engineering Dark/Light documentation palettes (neutral greys, green accent, system fonts) and a token-based Mermaid contrast layer, consumed through Starlight customCss.",
  "keywords": [
    "starlight",
    "astro",
    "theme",
    "mermaid",
    "docs",
    "css",
    "csd"
  ],
  "license": "MIT",
  "author": "Rafael Pires",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foundryRB/rb-csd-library.git",
    "directory": "starlight-theme"
  },
  "homepage": "https://github.com/foundryRB/rb-csd-library/tree/main/starlight-theme#readme",
  "bugs": {
    "url": "https://github.com/foundryRB/rb-csd-library/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@foundryrb/vitest-intent": "file:../vitest-intent",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
